# PostgreSQL database connection configuration
# Format: postgresql://username:password@host:port/database_name
# 
# Usage:
# 1. Copy this file as .env
# 2. Modify the connection information below to your actual database configuration
#
# Example:
# POSTGRES_DSN=postgresql://postgres:your_password@localhost:5432/airline_db
#
# If using SSL connection:
# POSTGRES_DSN=postgresql://postgres:your_password@localhost:5432/airline_db?sslmode=require
#
# If using remote database:
# POSTGRES_DSN=postgresql://user:password@your_host:5432/airline_db

POSTGRES_DSN=postgresql://postgres:your_password@localhost:5432/airline_db

